# --- database ---------------------------------------------------------------
# Its own database on the existing Postgres, alongside linkmonitor.
DATABASE_URL=postgresql://postgres:PASSWORD@host.docker.internal:5432/prospectqa

# --- Ahrefs ------------------------------------------------------------------
# Account settings -> API keys. Workspace owners/admins only; keys last 1 year.
#
# Budget: ~18 units per domain for the gate, ~130 more for each domain that
# survives it. A 1,000-domain run at the historical 80% survival rate is about
# 131,000 units, and the top-pages call is ~80% of that.
AHREFS_API_KEY=

# --- Anthropic ---------------------------------------------------------------
# Extraction runs on Haiku 4.5, judgement on Opus 5. Leave unset to fall back to
# an `ant auth login` profile, which the SDK resolves on its own.
ANTHROPIC_API_KEY=

# --- crawler -----------------------------------------------------------------
# Must NOT look generic. This host also runs Link Monitoring's crawler under
# Cloudflare's Verified Bots programme; an anonymous fetcher from this address
# undermines that application. See ../index/docs/adr/0003.
QA_USER_AGENT=ProspectQA/1.0 (+https://plinkocasi.com/qa/bot)

# Parallel homepage fetches. Network-bound, so this is not CPU sizing.
FETCH_CONCURRENCY=6

# How long an Ahrefs result stays good. Publishers do not move fast, and a
# cache hit is the difference between 0 and 148 units for a repeated domain.
METRICS_CACHE_DAYS=14
JEV_API_KEY=
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
