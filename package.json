    "qa": "tsx src/qa/run.ts",
    "lang-check": "tsx src/qa/langCheck.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "impit": "^0.14.4",
    "next": "^16.3.4",
    "node-cron": "^4.6.0",
    "p-limit": "^7.3.2",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "robots-parser": "^3.0.1",
    "tinyld": "^1.3.4",
    "turndown": "^7.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
